{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OraxDesk",
  "version": "0.31.7",
  "identifier": "com.deskvncviewer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../ui && node ../scripts/stage-sidecar.mjs",
    "beforeBundleCommand": "cargo build --release -p dvv",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OraxDesk",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "OraxDesk",
    "windows": {
      "wix": {
        "upgradeCode": "FA41490A-739C-52D9-85D4-5C013BC95320"
      }
    },
    "targets": "all",
    "externalBin": [
      "binaries/dvv"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "MacOS/dvv": "../target/release/dvv"
      },
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["oraxdesk"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwOTM3MzE5OUQ2NDk1NEUKUldST2xXU2RHWE9UVUxsVGs4MXJIN3l4S2R1aXdpL3gxNy9xWVpCd09nQXI0K054YWRUTGlXWDkK",
      "endpoints": [
        "https://github.com/Mohammedorax/OraxDesk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
